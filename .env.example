# ==============================================
# JobTracker AI — Environment Variables
# ==============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Where to find each value:
#   DATABASE_URL       → https://console.neon.tech → your project → Connection Details → copy the connection string
#   NEXTAUTH_SECRET    → Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   NEXTAUTH_URL       → http://localhost:3000 for local dev
#   GOOGLE_CLIENT_ID   → https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
#   GOOGLE_CLIENT_SECRET → Same as above
#   OPENAI_API_KEY     → https://platform.openai.com → API Keys
#
# For the hackathon (Bedrock):
#   AWS_REGION              → ap-south-1 (Mumbai)
#   AWS_ACCESS_KEY_ID       → https://console.aws.amazon.com → IAM → Users → Security credentials
#   AWS_SECRET_ACCESS_KEY   → Same as above
#   BEDROCK_MODEL_ID        → anthropic.claude-3-haiku-20240307-v1:0
# ==============================================

# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@ep-xxxxx.ap-south-1.aws.neon.tech/dbname?sslmode=require"

# --- NextAuth ---
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth ---
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxx"

# --- OpenAI (fallback LLM) ---
OPENAI_API_KEY="sk-proj-xxxxx"

# --- Amazon Bedrock (primary LLM for hackathon) ---
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"
